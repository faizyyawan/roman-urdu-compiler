adad x = 10 kardo
adad y = 10 kardo
adad z = 20 kardo

agar (x barabar y) {
    dikhao("x aur y barabar hain") kardo
}

agar (x nahibarabar z) {
    dikhao("x aur z barabar nahi hain") kardo
}

agar (z bara hay x) {
    dikhao("z x se bara hay") kardo
}

agar (x chota hay z) {
    dikhao("x z se chota hay") kardo
}

agar (z bara barabar y) {
    dikhao("z y se bara ya barabar hay") kardo
}

agar (x chota barabar y) {
    dikhao("x y se chota ya barabar hay") kardo
}

wapis 0 kardo
