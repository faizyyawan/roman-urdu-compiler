# Roman Urdu Compiler demonstration
adad x = 10 kardo
adad y = 20 kardo

agar (x < y) {
    dikhao("y bara hai") kardo
} warna {
    dikhao("x bara ya barabar hai") kardo
}

adad jama = 0 kardo
adad i = 1 kardo
jabtak (i <= 5) {
    jama = jama + i kardo
    i = i + 1 kardo
}

dikhao("1 se 5 tak jama:") kardo
dikhao(jama) kardo
wapis 0 kardo

